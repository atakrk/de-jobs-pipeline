# Postgres (matches docker-compose.yml)
PGHOST=localhost
PGPORT=5433
PGDATABASE=jobs
PGUSER=jobs
PGPASSWORD=jobs

# Ingest tuning. The search terms are not set here: they live in
# ingest/common.py, because an .env naming different terms from the daily job
# is how two runs of one pipeline came to measure two different markets.
MAX_PAGES=40
REQUEST_DELAY_SECONDS=0.5

# Databricks (optional - only needed for --target databricks)
# The token is a live credential: keep it here, never in a commit.
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
