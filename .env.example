# Postgres (matches docker-compose.yml)
PGHOST=localhost
PGPORT=5433
PGDATABASE=jobs
PGUSER=jobs
PGPASSWORD=jobs

# Ingest tuning.
# Values containing spaces are quoted so the file is shell-safe: dotenv
# tolerates unquoted spaces, `source` does not and tries to run the rest of
# the line as a command.
SEARCH_TERMS="data engineer,data engineering,analytics engineer"
MAX_PAGES=40
REQUEST_DELAY_SECONDS=0.5

# Databricks (optional - only needed for --target databricks)
# The token is a live credential: keep it here, never in a commit.
DATABRICKS_HOST=dbc-xxxxxxxx-xxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxx
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
